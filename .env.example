MONGODB_URI=mongodb://127.0.0.1:27017/smart_pet_tracker
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# ESP32 device ingestion
# 64 hex chars / 256-bit random secret used for ESP32 HMAC signatures.
DEVICE_API_KEY=replace-with-64-hex-char-device-secret
DEVICE_OWNER_EMAIL=your-login-email@example.com
